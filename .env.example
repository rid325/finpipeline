# Runtime traffic: use the pooled Neon URL and preserve its TLS query parameters.
DATABASE_URL=postgresql://user:password@project-pooler.region.aws.neon.tech/finpipeline?sslmode=require
# Migrations, pg_dump, and pg_restore: use Neon's direct (non-pooler) URL.
MIGRATION_DATABASE_URL=postgresql://user:password@project.region.aws.neon.tech/finpipeline?sslmode=require

SECRET_KEY=replace-with-a-random-secret
AUTH_USERNAME=
AUTH_PASSWORD=
FRED_API_KEY=
ENABLE_APSCHEDULER=false
DB_CONNECT_RETRIES=2
DB_CONNECT_TIMEOUT=10
NEWS_FEEDS_ENABLED=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
